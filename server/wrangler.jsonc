{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "servicehub-api",
  "main": "src/worker.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // Faxina diária do Storage (ver worker.ts / ArquivoService.limparOrfaos) — 03:30 em Brasília.
  "triggers": {
    "crons": ["30 6 * * *"]
  }
}
