SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-secret
LOG_LEVEL=info
JWT_SECRET=replace-with-a-long-random-secret

# Este .env.example é só de referência (usado por scripts/*.ts via `tsx
# --env-file=.env`). O servidor em si roda em Cloudflare Workers — pra
# desenvolvimento local use `server/.dev.vars` (mesmas chaves acima,
# lido automaticamente por `npm run dev` → `wrangler dev`) e em
# produção configure via `wrangler secret put <NOME>`.
